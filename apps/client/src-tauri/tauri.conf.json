{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ICT App",
  "version": "0.1.0",
  "identifier": "ai.i3w.ictapp",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "ICT App", "width": 1100, "height": 760, "minWidth": 800, "minHeight": 600 }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: ictfile: http://ictfile.localhost; media-src 'self' blob: ictfile: http://ictfile.localhost; frame-src 'self' blob: ictfile: http://ictfile.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
